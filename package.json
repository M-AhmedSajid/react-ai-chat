{
  "name": "react-ai-chat",
  "version": "2.4.0",
  "description": "Plug-and-play AI chatbot for React with RAG support.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/client/index.d.mts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.cjs"
    },
    "./style.css": "./dist/client/style.css",
    "./server": {
      "types": "./dist/server/index.d.mts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "react-ai-chat": "bin/react-ai-chat.js"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build"
  },
  "keywords": [
    "react",
    "ai",
    "chatbot",
    "rag",
    "llm",
    "ai-sdk",
    "embeddings",
    "vector-search",
    "google-ai",
    "openai",
    "voyageai",
    "cohere-ai",
    "jina-ai",
    "huggingface",
    "react-chatbot",
    "react-ai-chat"
  ],
  "author": "Muhammad Ahmed Sajid <ahmedsajid1506@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/react": "^4.0.58",
    "@inquirer/prompts": "^8.6.0",
    "ai": "^7.0.55",
    "dotenv": "^17.4.2",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "react-markdown": "^10.1.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "peerDependencies": {
    "@google/genai": "^2",
    "@huggingface/inference": "^4",
    "cohere-ai": "^8",
    "openai": "^7",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "voyageai": "^0"
  },
  "peerDependenciesMeta": {
    "@google/genai": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "voyageai": {
      "optional": true
    },
    "cohere-ai": {
      "optional": true
    },
    "@huggingface/inference": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M-AhmedSajid/react-ai-chat.git"
  },
  "homepage": "https://github.com/M-AhmedSajid/react-ai-chat#readme",
  "bugs": {
    "url": "https://github.com/M-AhmedSajid/react-ai-chat/issues"
  }
}
