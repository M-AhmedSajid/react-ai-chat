{
  "name": "next-ai-chatbot",
  "version": "1.2.0",
  "description": "Plug-and-play AI chatbot for Next.js with RAG support.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "next-ai-chatbot": "bin/next-ai-chatbot.js"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build"
  },
  "keywords": [
    "nextjs",
    "ai",
    "chatbot",
    "rag",
    "llm",
    "ai-sdk",
    "embeddings",
    "vector-search",
    "google-ai",
    "openai",
    "react",
    "next-ai-chatbot"
  ],
  "author": "Muhammad Ahmed Sajid <ahmedsajid1506@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/react": "^4.0.58",
    "ai": "^7.0.55",
    "dotenv": "^17.4.2",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "react-markdown": "^10.1.0"
  },
  "peerDependencies": {
    "@google/genai": "^2",
    "@huggingface/inference": "^4",
    "cohere-ai": "^8",
    "next": "^15 || ^16",
    "openai": "^5",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "voyageai": "^0"
  },
  "peerDependenciesMeta": {
    "@google/genai": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "voyageai": {
      "optional": true
    },
    "cohere-ai": {
      "optional": true
    },
    "@huggingface/inference": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M-AhmedSajid/next-ai-chatbot.git"
  },
  "homepage": "https://github.com/M-AhmedSajid/next-ai-chatbot#readme",
  "bugs": {
    "url": "https://github.com/M-AhmedSajid/next-ai-chatbot/issues"
  }
}
